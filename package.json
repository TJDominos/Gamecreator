{
  "name": "rsdev-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-version.js && vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-version.js && vite build && node scripts/generate-route-html.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "postinstall": "cd vendor/RS && npm install && npm run build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute gamecreator-d1 --local --file=./migrations/0001_init.sql",
    "d1:migrate:remote": "wrangler d1 execute gamecreator-d1 --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/identity": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tripletree/rs-design-system": "file:vendor/RS",
    "@uiw/react-md-editor": "^4.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.17.0",
    "sass": "^1.100.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.28.0",
    "tiptap-markdown": "^0.9.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
