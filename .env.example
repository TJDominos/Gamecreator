# Main Site URL (Defaults to https://test.randseed.org for testing)
VITE_MAIN_SITE_URL=https://test.randseed.org

# WL-Private SSO Login URL (e.g., https://test.randseed.org/login)
VITE_WL_LOGIN_URL=https://test.randseed.org/login

# Cloudflare Worker API Base URL (leave empty in local dev when using Vite proxy /api)
VITE_API_BASE_URL=

# ==============================================================================
# GitHub App Configuration (Backend / Worker Secrets)
# ==============================================================================
# GitHub App numeric ID from github.com/settings/apps/<app-name>
GITHUB_APP_ID=
# GitHub App public slug (e.g. randseed-game-engine)
GITHUB_APP_SLUG=randseed-game-engine
# GitHub App Client ID
GITHUB_CLIENT_ID=
# GitHub App Client Secret
GITHUB_CLIENT_SECRET=
# GitHub App Webhook Secret (for HMAC SHA-256 signature verification)
GITHUB_WEBHOOK_SECRET=
# GitHub App Private Key (.pem file content in single-line with \n or base64)
GITHUB_APP_PRIVATE_KEY=
# RandSeed Sandbox base URL
SANDBOX_BASE_URL=https://randseed.org/sandbox
