{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamecreator-play-dev",
  "main": "rust-worker/build/index.js",
  "build": {
    "command": "WORKER_FEATURES=play sh scripts/build-rust-worker.sh"
  },
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamecreator-d1",
      "database_id": "320c8dd3-7348-4675-9f3d-e384e1713f63",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "gamecreator-artifacts-dev"
    }
  ],
  "vars": {
    "GAME_CSP_CONNECT_SRC": "'self'"
  },
  "env": {
    "dev": {
      "name": "gamecreator-play-dev",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gamecreator-d1",
          "database_id": "320c8dd3-7348-4675-9f3d-e384e1713f63",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "gamecreator-artifacts-dev"
        }
      ],
      "vars": {
        "ENVIRONMENT": "dev",
        "GAME_CSP_CONNECT_SRC": "'self'"
      }
    },
    "test": {
      "name": "gamecreator-play-test",
      "routes": [{ "pattern": "test.randseed.org", "custom_domain": true }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "gamecreator-d1-test",
        "database_id": "REPLACE_WITH_TEST_D1_DATABASE_ID",
        "remote": true
      }],
      "r2_buckets": [{
        "binding": "ARTIFACTS",
        "bucket_name": "gamecreator-artifacts-test"
      }],
      "vars": {
        "ENVIRONMENT": "test",
        "GAME_CSP_CONNECT_SRC": "'self'"
      }
    },
    "production": {
      "name": "gamecreator-play-production",
      "routes": [{ "pattern": "randseed.org", "custom_domain": true }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "gamecreator-d1-production",
        "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
        "remote": true
      }],
      "r2_buckets": [{
        "binding": "ARTIFACTS",
        "bucket_name": "gamecreator-artifacts-production"
      }],
      "vars": {
        "ENVIRONMENT": "production",
        "GAME_CSP_CONNECT_SRC": "'self'"
      }
    }
  }
}
